@model Northwind.TradingPost.Domain.Product

@{
    ViewData["Title"] = "Edit Product";
    var categories = (IEnumerable<Northwind.TradingPost.Domain.Category>)ViewBag.Categories;
}

<h1>Edit Product</h1>

<form asp-action="Edit" method="post">
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <input type="hidden" name="ProductId" value="@Model.ProductId" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Product ID</label>
                    <input type="text" class="form-control" value="@Model.ProductId" readonly />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" class="form-control" name="ProductName" value="@Model.ProductName" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Supplier ID</label>
                    <input type="number" class="form-control" name="SupplierId" value="@Model.SupplierId" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Category</label>
                    <select class="form-select" name="CategoryId">
                        <option value="">-- Select Category --</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId ? "selected" : null)">@category.CategoryName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Quantity Per Unit</label>
                    <input type="text" class="form-control" name="QuantityPerUnit" value="@Model.QuantityPerUnit" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Unit Price</label>
                    <input type="number" step="0.01" class="form-control" name="UnitPrice" value="@Model.UnitPrice" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Units In Stock</label>
                    <input type="number" class="form-control" name="UnitsInStock" value="@Model.UnitsInStock" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Units On Order</label>
                    <input type="number" class="form-control" name="UnitsOnOrder" value="@Model.UnitsOnOrder" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Reorder Level</label>
                    <input type="number" class="form-control" name="ReorderLevel" value="@Model.ReorderLevel" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Discontinued</label>
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" name="Discontinued" value="true" @(Model.Discontinued ? "checked" : "") />
                        <label class="form-check-label">Product is discontinued</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </div>
</form>
