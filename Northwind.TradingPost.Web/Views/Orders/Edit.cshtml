@model Northwind.TradingPost.Domain.Order

@{
    ViewData["Title"] = "Edit Order";
    var orderDetails = (IEnumerable<Northwind.TradingPost.Domain.OrderDetail>)ViewBag.OrderDetails;
    int detailsPage = ViewBag.DetailsCurrentPage;
    int detailsTotalPages = ViewBag.DetailsTotalPages;
    int detailsPageSize = ViewBag.DetailsPageSize;
    string activeTab = ViewBag.ActiveTab ?? "order";
    bool isItemsTabActive = activeTab == "items";
}

<h1>Edit Order</h1>

<ul class="nav nav-tabs" id="orderTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(isItemsTabActive ? "" : "active")" id="order-tab" data-bs-toggle="tab" data-bs-target="#order" type="button" role="tab" aria-controls="order" aria-selected="@(isItemsTabActive ? "false" : "true")">Order Info</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(isItemsTabActive ? "active" : "")" id="items-tab" data-bs-toggle="tab" data-bs-target="#items" type="button" role="tab" aria-controls="items" aria-selected="@(isItemsTabActive ? "true" : "false")">Order Items</button>
    </li>
</ul>

<div class="tab-content" id="orderTabsContent">
    <div class="tab-pane fade @(isItemsTabActive ? "" : "show active")" id="order" role="tabpanel" aria-labelledby="order-tab">
        <form asp-action="Edit" method="post" class="mt-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <input type="hidden" name="OrderId" value="@Model.OrderId" />
                    <input type="hidden" name="activeTab" value="@activeTab" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Order ID</label>
                            <input type="text" class="form-control" value="@Model.OrderId" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Customer ID</label>
                            <input type="text" class="form-control" name="CustomerId" value="@Model.CustomerId" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Employee ID</label>
                            <input type="number" class="form-control" name="EmployeeId" value="@Model.EmployeeId" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Order Date</label>
                            <input type="date" class="form-control" name="OrderDate" value="@(Model.OrderDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Required Date</label>
                            <input type="date" class="form-control" name="RequiredDate" value="@(Model.RequiredDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Shipped Date</label>
                            <input type="date" class="form-control" name="ShippedDate" value="@(Model.ShippedDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ship Via</label>
                            <input type="number" class="form-control" name="ShipVia" value="@Model.ShipVia" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Freight</label>
                            <input type="number" step="0.01" class="form-control" name="Freight" value="@Model.Freight" />
                        </div>
                    </div>
                    <h5 class="mt-4 mb-3">Shipping Address</h5>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Ship Name</label>
                            <input type="text" class="form-control" name="ShipName" value="@Model.ShipName" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Ship Address</label>
                            <input type="text" class="form-control" name="ShipAddress" value="@Model.ShipAddress" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ship City</label>
                            <input type="text" class="form-control" name="ShipCity" value="@Model.ShipCity" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ship Region</label>
                            <input type="text" class="form-control" name="ShipRegion" value="@Model.ShipRegion" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ship Postal Code</label>
                            <input type="text" class="form-control" name="ShipPostalCode" value="@Model.ShipPostalCode" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ship Country</label>
                            <input type="text" class="form-control" name="ShipCountry" value="@Model.ShipCountry" />
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </div>
        </form>
    </div>

    <div class="tab-pane fade @(isItemsTabActive ? "show active" : "")" id="items" role="tabpanel" aria-labelledby="items-tab">
        <div class="card shadow-sm mt-3">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product ID</th>
                            <th>Product Name</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Discount</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!orderDetails.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No order items found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in orderDetails)
                            {
                                <tr>
                                    <td>@item.ProductId</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>@item.Quantity</td>
                                    <td>@((item.Discount * 100).ToString("0"))%</td>
                                    <td>@((item.UnitPrice * item.Quantity * (decimal)(1 - item.Discount)).ToString("C"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (detailsTotalPages > 1)
        {
            <nav aria-label="Order items pagination" class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(detailsPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Edit" asp-route-id="@Model.OrderId" asp-route-detailsPage="1" asp-route-detailsPageSize="@detailsPageSize" asp-route-activeTab="items">First</a>
                    </li>
                    <li class="page-item @(detailsPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Edit" asp-route-id="@Model.OrderId" asp-route-detailsPage="@(detailsPage - 1)" asp-route-detailsPageSize="@detailsPageSize" asp-route-activeTab="items">Previous</a>
                    </li>
                    
                    @for (int i = Math.Max(1, detailsPage - 2); i <= Math.Min(detailsTotalPages, detailsPage + 2); i++)
                    {
                        <li class="page-item @(i == detailsPage ? "active" : "")">
                            <a class="page-link" asp-action="Edit" asp-route-id="@Model.OrderId" asp-route-detailsPage="@i" asp-route-detailsPageSize="@detailsPageSize" asp-route-activeTab="items">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(detailsPage == detailsTotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Edit" asp-route-id="@Model.OrderId" asp-route-detailsPage="@(detailsPage + 1)" asp-route-detailsPageSize="@detailsPageSize" asp-route-activeTab="items">Next</a>
                    </li>
                    <li class="page-item @(detailsPage == detailsTotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Edit" asp-route-id="@Model.OrderId" asp-route-detailsPage="@detailsTotalPages" asp-route-detailsPageSize="@detailsPageSize" asp-route-activeTab="items">Last</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
